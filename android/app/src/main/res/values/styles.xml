<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HCCR" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar" />

    <!-- 注意:layout_width/height 从 style 走不一定生效,要在 layout XML 里直接写 -->
    <style name="CandidateButton">
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textColor">#000</item>
        <item name="android:background">@drawable/candidate_bg</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:enabled">false</item>
        <item name="android:alpha">0.4</item>
    </style>
</resources>
