<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="#666"
        android:text="@string/status_loading" />

    <!-- 候选栏 -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/candidates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView android:id="@+id/cand_0" style="@style/CandidateButton" />
            <TextView android:id="@+id/cand_1" style="@style/CandidateButton" />
            <TextView android:id="@+id/cand_2" style="@style/CandidateButton" />
            <TextView android:id="@+id/cand_3" style="@style/CandidateButton" />
            <TextView android:id="@+id/cand_4" style="@style/CandidateButton" />
            <TextView android:id="@+id/cand_5" style="@style/CandidateButton" />
            <TextView android:id="@+id/cand_6" style="@style/CandidateButton" />
            <TextView android:id="@+id/cand_7" style="@style/CandidateButton" />
            <TextView android:id="@+id/cand_8" style="@style/CandidateButton" />
            <TextView android:id="@+id/cand_9" style="@style/CandidateButton" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 画板 -->
    <com.shiyu.hccr.HandwritingView
        android:id="@+id/handwriting"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:background="@drawable/canvas_bg" />

    <!-- 控制栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:gravity="end">

        <Button
            android:id="@+id/btn_undo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_undo"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_clear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_clear" />
    </LinearLayout>
</LinearLayout>
